# ==============================================================================
# BHUBANESWAR ENGINEERING COLLEGE (BEC) - ACCOUNTS & FINANCE MANAGEMENT SYSTEM
# Environment Configuration Template
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development
BASE_URL=http://localhost:5000

# Hostinger MySQL Database Credentials
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bec_accounts_db
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=20
DB_WAIT_FOR_CONNECTIONS=true
DB_QUEUE_LIMIT=0

# JWT Authentication
JWT_SECRET=bec_secure_jwt_secret_production_key_2026_finance
JWT_EXPIRES_IN=8h

# Payment Gateway Configuration (Pluggable: MOCK, RAZORPAY, CASHFREE)
PAYMENT_GATEWAY_PROVIDER=MOCK
PAYMENT_GATEWAY_KEY=rzp_test_placeholder_key
PAYMENT_GATEWAY_SECRET=rzp_test_placeholder_secret
PAYMENT_WEBHOOK_SECRET=rzp_webhook_secret_key

# College Branding & System Settings
COLLEGE_NAME=Bhubaneswar Engineering College
COLLEGE_CODE=BEC
COLLEGE_AFFILIATION=Affiliated to BPUT, Odisha & Approved by AICTE
COLLEGE_EMAIL=accounts@bec.ac.in
COLLEGE_PHONE=+91-674-2970000
